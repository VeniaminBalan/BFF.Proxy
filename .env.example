# Copy to .env and fill in - used by docker-compose.yml

KEYCLOAK_REALM=
KEYCLOAK_AUTH_SERVER_URL=http://host.docker.internal:7080
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# Origin of the SPA the BFF should accept cross-origin requests from
SPA_ORIGIN=http://localhost:3000

# Base URL of the resource API the BFF proxies /api/** to
BACKEND_API_URL=http://host.docker.internal:6081
